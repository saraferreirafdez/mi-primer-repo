# Copia este fichero a .env y rellena los valores.
# .env esta en .gitignore: nunca se sube al repositorio.

# La direccion base. El robot genera alias del tipo info+tienda1234@sorasystems.es
RADAR_ALIAS_BASE="info@sorasystems.es"

# Datos IMAP del proveedor de correo
RADAR_IMAP_SERVIDOR="imap.tuproveedor.com"
RADAR_IMAP_USUARIO="info@sorasystems.es"
RADAR_IMAP_CLAVE=""

# Carpeta donde caen los correos del robot. NO uses INBOX:
# 270 auditorias son 270 suscripciones tapando tu correo de clientes.
RADAR_IMAP_CARPETA="Auditorias"
